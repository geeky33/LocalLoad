# LocalLoad backend configuration. Copy to .env and adjust. Never commit the real .env file.

# ---------------- Server ----------------

# Port for the REST API and Socket.IO server.
PORT=4000
# MongoDB connection string (local, Docker or hosted).
MONGODB_URI=mongodb://127.0.0.1:27017/localload
# Secret used to sign login tokens. Required when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-string
# How long a login token stays valid.
JWT_EXPIRES_IN=7d

# ---------------- Simulation (train positions are SIMULATED, not real GPS) ----------------

# Milliseconds between two simulation ticks.
SIMULATION_INTERVAL_MS=3000
# How many times faster than real time the simulated trains move.
SIMULATION_SPEED_MULTIPLIER=10
# Start moving trains automatically when the server starts.
SIMULATION_AUTOSTART=true

# ---------------- Simulated commuters ----------------

# Demo accounts report crowds live, based on the current Mumbai time.
SIMULATED_COMMUTERS=true
# Milliseconds between two groups of simulated reports.
SIM_COMMUTER_INTERVAL_MS=8000
# Comma-separated train numbers the simulated commuters never report on (kept clean for the live five-user demo).
SIM_COMMUTER_SKIP_TRAINS=90101

# ---------------- Alerts and verification ----------------

# Minimum time between two nearest-station alerts for the same user and station.
NEARBY_ALERT_COOLDOWN_MS=60000
# Reporting window: one vote per user per train and station in this period; older votes expire.
REPORT_WINDOW_MINUTES=10
# Distinct users required before a crowd or delay status can be confirmed.
VERIFICATION_THRESHOLD=5

# ---------------- Seed data (development only) ----------------

# Password given to the demo accounts created by `npm run seed`.
SEED_DEMO_PASSWORD=localload123
